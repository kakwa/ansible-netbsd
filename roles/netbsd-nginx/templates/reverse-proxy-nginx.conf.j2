{% if nginx_dns_resolvers is defined and nginx_dns_resolvers | length > 0 %}
# Extract hostname and port from upstream URL
{% set upstream_url = item.upstream %}
{% if upstream_url.startswith('http://') %}
    {% set upstream_proto = 'http' %}
    {% set upstream_host_port = upstream_url[7:] %}
{% elif upstream_url.startswith('https://') %}
    {% set upstream_proto = 'https' %}
    {% set upstream_host_port = upstream_url[8:] %}
{% else %}
    {% set upstream_proto = 'http' %}
    {% set upstream_host_port = upstream_url %}
{% endif %}

{% if '/' in upstream_host_port %}
    {% set upstream_host_port = upstream_host_port.split('/')[0] %}
{% endif %}

{% if ':' in upstream_host_port %}
    {% set upstream_host = upstream_host_port.split(':')[0] %}
    {% set upstream_port = upstream_host_port.split(':')[1] %}
{% else %}
    {% set upstream_host = upstream_host_port %}
    {% if upstream_proto == 'https' %}
        {% set upstream_port = '443' %}
    {% else %}
        {% set upstream_port = '80' %}
    {% endif %}
{% endif %}

# Upstream block for connection pooling
upstream {{ item.name }}_upstream {
    zone {{ item.name }} 256k;
    server {{ upstream_host }}:{{ upstream_port }} resolve;

    # Keep connections alive
    keepalive 32;
}
{% endif %}

server {
    listen 80;
    listen [::]:80;
    server_name {{ item.domain }};

    # Redundant but makes certbot less prone to modify the configuration
    if ($host = {{ item.domain }}) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    # Redirect HTTP to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ item.domain }};

    # SSL configuration - use Let's Encrypt if available, otherwise self-signed
{% if item.domain in letsencrypt_available_certs %}
    ssl_certificate /usr/pkg/etc/letsencrypt/live/{{ item.domain }}/fullchain.pem;
    ssl_certificate_key /usr/pkg/etc/letsencrypt/live/{{ item.domain }}/privkey.pem;
{% elif primary_letsencrypt_domain %}
    ssl_certificate /usr/pkg/etc/letsencrypt/live/{{ primary_letsencrypt_domain }}/fullchain.pem;
    ssl_certificate_key /usr/pkg/etc/letsencrypt/live/{{ primary_letsencrypt_domain }}/privkey.pem;
{% else %}
    ssl_certificate /usr/pkg/etc/nginx/ssl/selfsigned.crt;
    ssl_certificate_key /usr/pkg/etc/nginx/ssl/selfsigned.key;
{% endif %}

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    # Logging
    access_log /var/log/nginx/{{ item.name }}_access.log;
    error_log /var/log/nginx/{{ item.name }}_error.log;

    # Basic authentication
    # When wake_enabled, auth checks are moved into the /_wake subrequest
    # location so auth_request (ACCESS phase) fires before any 401 is sent.
{% if item.auth_enabled | default(false) and not item.wake_enabled | default(false) %}
    auth_basic "Restricted Access";
    auth_basic_user_file /usr/pkg/etc/nginx/.htpasswd.{{ item.name }};
{% endif %}

{% if item.api_key_auth_enabled | default(false) and not item.wake_enabled | default(false) %}
    # API key authentication (OpenAI-compatible: Authorization: Bearer <key>)
    # default_type only affects responses nginx generates itself (like the 401
    # below); proxied responses keep the Content-Type from the upstream.
    default_type application/json;
    set $api_key_ok 0;
    if ($http_authorization = "Bearer {{ item.api_key }}") {
        set $api_key_ok 1;
    }
    if ($api_key_ok != 1) {
        return 401 '{"error": {"message": "Invalid or missing API key", "type": "invalid_api_key", "param": null, "code": null}}';
    }
{% endif %}

    # Proxy settings
    location / {
{% if item.wake_enabled | default(false) and item.auth_enabled | default(false) %}
        # Basic auth in PREACCESS phase — runs AFTER auth_request (ACCESS phase),
        # so the waker is consulted before credentials are validated.
        auth_basic "Restricted Access";
        auth_basic_user_file /usr/pkg/etc/nginx/.htpasswd.{{ item.name }};
{% endif %}
{% if item.wake_enabled | default(false) %}
        # Ask the waker to bring the backend up before proxying. Do not
        # gate on the method: nginx runs auth_request subrequests as GET
        # even when the original request was a POST.
        auth_request /_wake;
{% endif %}

{% if nginx_dns_resolvers is defined and nginx_dns_resolvers | length > 0 %}
        # Extract path from upstream URL for proxy_pass when using upstream blocks
{% set upstream_path = '' %}
{% if '/' in item.upstream.split('://', 1)[1] %}
    {% set upstream_path = '/' + item.upstream.split('://', 1)[1].split('/', 1)[1] %}
    # Path extracted: {{ upstream_path }}
{% endif %}

{% if item.auth_enabled | default(false) %}
        # Prevent caching to ensure browser always prompts for Basic Auth credentials
        # This ensures WebSocket connections have access to the auth credentials
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
{% endif %}

        proxy_pass {{ upstream_proto }}://{{ item.name }}_upstream{{ upstream_path }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
{% if item.upstream_api_key is defined %}

        # Authenticate to the backend service with the configured API key
        # (replaces any Authorization header sent by the client)
        proxy_set_header Authorization "Bearer {{ item.upstream_api_key }}";
{% endif %}

        # SSL verification settings for HTTPS backends
{% if upstream_proto == 'https' and not (item.ssl_verify | default(reverse_proxy_defaults.ssl_verify | default(true))) %}
        proxy_ssl_verify off;
        proxy_ssl_server_name off;
{% endif %}

        # HTTP/1.1 for WebSocket support and keep-alive connections
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeouts - extended for WebSocket/streaming connections if websocket_path or streaming is defined
        proxy_connect_timeout 60s;
{% if item.websocket_path is defined or item.streaming | default(false) %}
        proxy_send_timeout 3600s;  # 1 hour for WebSocket
        proxy_read_timeout 3600s;  # 1 hour for WebSocket
{% else %}
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
{% endif %}

        # Handle DNS resolution failures gracefully
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;

        # Buffer settings
{% if item.websocket_path is defined or item.streaming | default(false) %}
        proxy_buffering off;  # Disable buffering for WebSocket
{% else %}
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
{% endif %}
{% else %}
        # Fallback to direct proxy_pass when DNS resolvers are not configured
        proxy_pass {{ item.upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
{% if item.upstream_api_key is defined %}

        # Authenticate to the backend service with the configured API key
        # (replaces any Authorization header sent by the client)
        proxy_set_header Authorization "Bearer {{ item.upstream_api_key }}";
{% endif %}

        # SSL verification settings for HTTPS backends
{% if item.upstream.startswith('https://') and not (item.ssl_verify | default(reverse_proxy_defaults.ssl_verify | default(true))) %}
        proxy_ssl_verify off;
        proxy_ssl_server_name off;
{% endif %}

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeouts - extended for WebSocket/streaming connections if websocket_path or streaming is defined
        proxy_connect_timeout 60s;
{% if item.websocket_path is defined or item.streaming | default(false) %}
        proxy_send_timeout 3600s;  # 1 hour for WebSocket
        proxy_read_timeout 3600s;  # 1 hour for WebSocket
{% else %}
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
{% endif %}

        # Handle DNS resolution failures gracefully
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;

        # Buffer settings
{% if item.websocket_path is defined or item.streaming | default(false) %}
        proxy_buffering off;  # Disable buffering for WebSocket
{% else %}
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
{% endif %}
{% endif %}
    }

{% if item.wake_enabled | default(false) %}
    # Internal subrequest: wake the backend via the waker service.
    # API-key auth (if/return) works here because REWRITE phase runs in
    # subrequests. Basic auth (auth_basic) is placed in location / instead
    # because PREACCESS phase is skipped in subrequests.
    location = /_wake {
        internal;
{% if item.api_key_auth_enabled | default(false) %}
        default_type application/json;
        set $api_key_ok 0;
        if ($http_authorization = "Bearer {{ item.api_key }}") {
            set $api_key_ok 1;
        }
        if ($api_key_ok != 1) {
            return 401 '{"error": {"message": "Invalid or missing API key", "type": "invalid_api_key", "param": null, "code": null}}';
        }
{% endif %}
        proxy_pass {{ item.wake_url | default(nginx_waker_url) }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout {{ item.wake_timeout | default(nginx_waker_timeout) }}s;
    }

{% endif %}
    # Health check endpoint (optional)
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

